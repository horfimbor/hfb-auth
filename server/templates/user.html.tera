{% extends "base" %}
{% block title %}account{% endblock title %}

{% block content %}

<h2>User</h2>
<ul>
    <li>pseudo : {{account.pseudo}}</li>
    {% if is_admin %}
    <li>admin : yes</li>
    {% else %}
    <li>admin : no</li>
    {% endif %}
</ul>
<div class="links">
    {% if is_admin %}
    <a href="{{uri_applications}}">Applications</a>
    {% endif %}
    <a href="#"></a>
    <a href="/logout">Logout</a>
</div>
{% endblock content %}