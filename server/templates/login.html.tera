{% extends "base" %}
{% block title %}login{% endblock title %}

{% block content %}
<h2>Sign In</h2>
{% if error %}
<h3>{{error}}</h3>
{% endif %}
<form action="/login" method="post">
    <div class="inputBox">
        <input type="text" required name="identity" minlength="10" maxlength="50"/> <i>Identifier</i>
    </div>
    <div class="inputBox">
        <input type="password" required name="password" minlength="10" maxlength="50"/> <i>Password</i>
    </div>
    <div class="links">
        <a href="#"></a>
        <a href="/register">Signup</a>
    </div>
    <div class="inputBox">
        <input type="hidden" name="csrf" value="{{csrf}}"/>
        <input type="submit" value="Login">
    </div>
</form>
{% endblock content %}